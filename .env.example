# Public recruitment API root, without /admin/dashboard.
# Tokens are obtained automatically. Verification keys belong on the backend.
VITE_RECRUITMENT_API_URL=https://recruitmentbackend.outrightsystems.org/api

# CRM backend domain, without a trailing /index.php. Every CRM request uses it.
VITE_CRM_URL=https://flight.hrcrm.ai

# Haunted Office Halloween game: the deployed game address, and the same key as
# SECRET_KEY in the game's src/game/token.js (or its VITE_TOKEN_KEY).
VITE_HAUNTED_OFFICE_URL=
VITE_HAUNTED_OFFICE_TOKEN_KEY=

# Who sees the Halloween theme and game: admin (admins only) | all (all employees) | off
VITE_SHOW_HALLOWEEN_THEME=all
# Emails that never see the Halloween theme or game, separated by commas, e.g. a@x.com,b@x.com
VITE_HALLOWEEN_EXCLUDED_EMAILS=
# Emails that always see the Halloween theme and game, even when the setting above is admin or off.
# Excluded emails win if an address is on both lists.
VITE_HALLOWEEN_ALLOWED_EMAILS=
# Company name printed as "Billed to" on quotation invoices. Defaults to HRCRM.
VITE_COMPANY_NAME=
