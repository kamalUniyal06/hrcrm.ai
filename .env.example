# Public recruitment API root, without /admin/dashboard.
# Tokens are obtained automatically. Verification keys belong on the backend.
VITE_RECRUITMENT_API_URL=https://recruitmentbackend.outrightsystems.org/api

# CRM backend domain, without a trailing /index.php. Every CRM request uses it.
VITE_CRM_URL=https://flight.hrcrm.ai

# Company name printed as "Billed to" on quotation invoices. Defaults to HRCRM.
VITE_COMPANY_NAME=
