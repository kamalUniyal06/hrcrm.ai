{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(npm test)",
      "Bash(npm test *)",
      "Bash(node --test *)",
      "Bash(npx eslint *)",
      "Bash(git status*)",
      "Bash(git diff*)",
      "Bash(git log*)"
    ],
    "ask": [
      "Bash(npm run dev*)",
      "Bash(npm start*)",
      "Bash(npm run build*)",
      "Bash(npm run preview*)",
      "Bash(npx vite*)",
      "Bash(vite*)",
      "Bash(node *vite.js*)",
      "PowerShell(npm run dev*)",
      "PowerShell(npm start*)",
      "PowerShell(npm run build*)",
      "PowerShell(npm run preview*)",
      "PowerShell(npx vite*)",
      "PowerShell(vite*)",
      "PowerShell(node *vite.js*)",
      "Bash(git commit*)",
      "Bash(git push*)",
      "PowerShell(git commit*)",
      "PowerShell(git push*)"
    ],
    "deny": [
      "Read(./.env)",
      "Read(./.env.*.local)"
    ]
  }
}
